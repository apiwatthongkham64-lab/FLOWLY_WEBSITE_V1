NODE_ENV=development
PORT=8787
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5500
TRUST_PROXY=false

# Authentication
AUTH_MODE=demo
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
JWT_ISSUER=flowly-api
JWT_AUDIENCE=flowly-web
COOKIE_NAME=flowly_session

# PostgreSQL
DATABASE_URL=postgresql://flowly:change-me@localhost:5432/flowly
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Request security
JSON_LIMIT=256kb
GLOBAL_RATE_LIMIT_MAX=180
LOGIN_RATE_LIMIT_MAX=10
PUBLIC_REQUEST_RATE_LIMIT_MAX=20

# Backups
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
