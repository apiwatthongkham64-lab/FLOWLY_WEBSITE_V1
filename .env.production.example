# Copy to .env.production before deployment. Never commit the real file.
APP_ORIGIN=https://your-domain.example
WEB_PORT=8080
POSTGRES_DB=flowly
POSTGRES_USER=flowly
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_URL_SAFE_PASSWORD
DATABASE_URL=postgresql://flowly:REPLACE_WITH_THE_SAME_URL_SAFE_PASSWORD@db:5432/flowly

NODE_ENV=production
PORT=8787
API_PREFIX=/api/v1
FRONTEND_ORIGIN=https://your-domain.example
TRUST_PROXY=true
AUTH_MODE=database
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRES_IN=8h
JWT_ISSUER=flowly-api
JWT_AUDIENCE=flowly-web
COOKIE_NAME=flowly_session
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
JSON_LIMIT=256kb
GLOBAL_RATE_LIMIT_MAX=180
LOGIN_RATE_LIMIT_MAX=10
PUBLIC_REQUEST_RATE_LIMIT_MAX=20
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
